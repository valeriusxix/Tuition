# Tuition environment. Copy to .env (never commit .env) and fill in the four secrets.
# Every other variable is optional: delete it or leave it empty to use the default shown.
# Secrets are read only by engine/. Never prefix anything with VITE_ and never read these in web/.

# ── Secrets ─────────────────────────────────────────────────────────────────
# Anthropic API key. console.anthropic.com → API Keys. Not needed for --dry runs.
# An Orbio gateway key also works: set ANTHROPIC_BASE_URL below and use OpenRouter model IDs.
ANTHROPIC_API_KEY=
# Anthropic-compatible endpoint (default https://api.anthropic.com).
# For Orbio: https://api.orbio.so/api with FORECAST_MODEL=anthropic/claude-haiku-5.5 and
# REFLECT_MODEL=anthropic/claude-sonnet-5.5
ANTHROPIC_BASE_URL=
# Tatum API key (mainnet). dashboard.tatum.io → API keys. Used for OHLCV and the Sui RPC gateway.
TATUM_API_KEY=
# Walrus Memory delegate private key (Ed25519, hex). memory.walrus.xyz → SDK credentials.
MEMWAL_PRIVATE_KEY=
# Walrus Memory account OBJECT ID: 0x + 64 hex. memory.walrus.xyz. NOT your wallet address.
MEMWAL_ACCOUNT_ID=

# ── Models ──────────────────────────────────────────────────────────────────
# Forecast model (default claude-haiku-5-5)
FORECAST_MODEL=
# Reflection / post-mortem model (default claude-sonnet-5-5)
REFLECT_MODEL=

# ── Endpoints ───────────────────────────────────────────────────────────────
# Tatum OHLCV batch endpoint (default https://api.tatum.io/v4/data/rate/symbol/OHLCV/batch)
TATUM_OHLCV_BATCH_URL=
# Tatum single-candle OHLCV endpoint (default https://api.tatum.io/v4/data/rate/symbol/OHLCV)
TATUM_OHLCV_URL=
# Tatum Sui mainnet RPC gateway (default https://sui-mainnet.gateway.tatum.io)
TATUM_SUI_RPC_URL=
# Walrus Memory relayer, mainnet (default https://relayer.memory.walrus.xyz).
# Never point mainnet credentials at the staging relayer.
MEMWAL_SERVER_URL=
# Walrus aggregator for blob availability checks (default https://aggregator.walrus-mainnet.walrus.space)
WALRUS_AGGREGATOR_URL=

# ── Memory backend ──────────────────────────────────────────────────────────
# walrus (default) or memory (in-memory store: tests and --dry runs only)
MEMORY_BACKEND=

# ── Experiment ──────────────────────────────────────────────────────────────
# Comma list of Tatum symbols (default BTC,ETH,SOL,SUI). At least 3 must be supported.
ASSETS=
# First decision date, a Monday, UTC (default 2026-03-02)
REPLAY_START=
# Last decision date, a Monday, UTC (default 2026-10-12)
REPLAY_END=
# Decision dates on or before this are the dev split, later ones are test (default 2026-05-25)
DEV_SPLIT_END=
# Forecast horizon in days (default 7)
HORIZON_DAYS=
# Seed for the asset shuffle, run IDs and the bootstrap (default 42)
SEED=

# ── Memory tuning (tune only on the dev split, at most 3 runs) ─────────────
# Lessons recalled per forecast (default 5)
RECALL_LIMIT=
# Drop recalled memories with distance >= this (default 0.8)
RECALL_MAX_DISTANCE=
# Write a lesson when |p - outcome| >= this (default 0.45)
LESSON_ERROR_THRESHOLD=

# ── Throughput ──────────────────────────────────────────────────────────────
# Parallel Walrus Memory writes (default 2)
MEMWAL_WRITE_CONCURRENCY=
# Soft cap on Walrus Memory writes per hour (default 120)
MEMWAL_MAX_WRITES_PER_HOUR=
# Parallel LLM calls (default 4)
LLM_CONCURRENCY=

# ── Live mode ───────────────────────────────────────────────────────────────
# Comma list of extra lesson namespaces for live recall.
# Set to the official run's lesson namespace after the replay completes (default empty).
LIVE_LESSON_NAMESPACES=
